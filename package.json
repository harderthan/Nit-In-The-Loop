{
  "name": "nitl",
  "displayName": "NITL",
  "description": "Local line-by-line review threads for Git changes and coding agents",
  "version": "0.1.8",
  "publisher": "NickyKim",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "type": "commonjs",
  "scripts": {
    "compile": "tsc -p .",
    "test": "node --import tsx --test src/**/*.test.ts src/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "activationEvents": [
    "onView:agentReview.changes",
    "onView:agentReview.blame",
    "onCommand:agentReview.openDiff"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentReview",
          "title": "NITL",
          "icon": "assets/review.svg"
        }
      ]
    },
    "views": {
      "agentReview": [
        {
          "id": "agentReview.changes",
          "name": "Changed Files"
        },
        {
          "id": "agentReview.blame",
          "name": "Git Blame"
        }
      ]
    },
    "commands": [
      {
        "command": "agentReview.openDiff",
        "title": "Open Review Diff",
        "icon": "$(diff)"
      },
      {
        "command": "agentReview.showBlame",
        "title": "Show Git Blame",
        "icon": "$(git-commit)"
      },
      {
        "command": "agentReview.openBlameLine",
        "title": "Open Blamed Line"
      },
      {
        "command": "agentReview.openHistoryFile",
        "title": "Open Commit Change"
      },
      {
        "command": "agentReview.openCommitComments",
        "title": "Open Commit Comments",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentReview.loadMoreHistory",
        "title": "Load More Commits"
      },
      {
        "command": "agentReview.refresh",
        "title": "Refresh Reviews",
        "icon": "$(refresh)"
      },
      {
        "command": "agentReview.createThread",
        "title": "Send to Agent",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "agentReview.queueThread",
        "title": "Add to Queue",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "agentReview.reply",
        "title": "Send to Agent",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "agentReview.queueReply",
        "title": "Add to Queue",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "agentReview.resolve",
        "title": "Resolve Review Thread"
      },
      {
        "command": "agentReview.reopen",
        "title": "Reopen Review Thread"
      },
      {
        "command": "agentReview.showStale",
        "title": "View Outdated Review Thread"
      },
      {
        "command": "agentReview.copyCliCommand",
        "title": "Copy NITL CLI Command",
        "icon": "$(copy)"
      },
      {
        "command": "agentReview.sendQueue",
        "title": "Send Queued Comments to Agent",
        "icon": "$(send)"
      },
      {
        "command": "agentReview.sendThread",
        "title": "Send Queued Comments to Agent",
        "icon": "$(send)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentReview.refresh",
          "when": "view == agentReview.changes",
          "group": "navigation"
        },
        {
          "command": "agentReview.copyCliCommand",
          "when": "view == agentReview.changes",
          "group": "navigation"
        },
        {
          "command": "agentReview.refresh",
          "when": "view == agentReview.blame",
          "group": "navigation"
        },
        {
          "command": "agentReview.sendQueue",
          "when": "view == agentReview.changes || view == agentReview.blame",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentReview.openDiff",
          "when": "view == agentReview.changes",
          "group": "inline"
        },
        {
          "command": "agentReview.openCommitComments",
          "when": "view == agentReview.blame && viewItem == historyCommit",
          "group": "inline"
        },
        {
          "command": "agentReview.showBlame",
          "when": "view == agentReview.changes && viewItem == changedFile",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "agentReview.createThread",
          "when": "agentReview.reviewEditor",
          "group": "1_modification"
        },
        {
          "command": "agentReview.queueThread",
          "when": "agentReview.reviewEditor",
          "group": "1_modification"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "agentReview.createThread",
          "when": "commentController == agent-review && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "agentReview.queueThread",
          "when": "commentController == agent-review && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "agentReview.reply",
          "when": "commentController == agent-review && !commentThreadIsEmpty && commentThread =~ /^open/",
          "group": "inline"
        },
        {
          "command": "agentReview.queueReply",
          "when": "commentController == agent-review && !commentThreadIsEmpty && commentThread =~ /^open/",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "agentReview.sendThread",
          "when": "commentController == agent-review && commentThread == openQueued",
          "group": "inline"
        },
        {
          "command": "agentReview.resolve",
          "when": "commentController == agent-review && commentThread =~ /^open/",
          "group": "inline"
        },
        {
          "command": "agentReview.reopen",
          "when": "commentController == agent-review && commentThread == resolved",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "agentReview.reply",
          "when": "false"
        },
        {
          "command": "agentReview.queueReply",
          "when": "false"
        },
        {
          "command": "agentReview.resolve",
          "when": "false"
        },
        {
          "command": "agentReview.reopen",
          "when": "false"
        },
        {
          "command": "agentReview.openBlameLine",
          "when": "false"
        },
        {
          "command": "agentReview.openHistoryFile",
          "when": "false"
        },
        {
          "command": "agentReview.loadMoreHistory",
          "when": "false"
        },
        {
          "command": "agentReview.openCommitComments",
          "when": "false"
        },
        {
          "command": "agentReview.showStale",
          "when": "false"
        },
        {
          "command": "agentReview.sendThread",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "NITL",
      "properties": {
        "agentReview.agentCommand": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Command that runs your coding agent, for example `claude -p` or `codex exec -`. NITL runs it without a shell in the repository root and sends the review prompt on stdin, or in place of a `{prompt}` argument. The agent's printed answer is posted as its reply. For `claude`, NITL adds `--session-id` or `--resume` so that each thread keeps its session. This setting is read only from user settings, never from a workspace."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/agent-review/review.json",
        "url": "./schema/review.schema.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vscode-uri": "^3.2.0"
  },
  "bin": {
    "nitl": "./dist/cli.js",
    "agent-review": "./dist/cli.js"
  }
}
